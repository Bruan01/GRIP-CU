# macOS / editors
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python environments and caches
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Model and training artifacts
model_cache/
**/model_cache/
wandb/
**/wandb/
*.safetensors
*.ckpt
*.pth
*.pt

# Generated outputs and immutable run data
outputs/
**/outputs/
**/results/*
!**/results/.gitkeep
**/logs/*.log
**/logs/*.txt

# Local benchmark data and task files (kept outside Git)
04_benchmark/data/

# Vendored GRIP baseline: source stays in this monorepo, while raw datasets
# and local experiment artifacts remain machine-local.
13_base_method/grip-exp/artifacts/
13_base_method/grip-exp/outputs/
13_base_method/grip-exp/data/raw_datasets/**
!13_base_method/grip-exp/data/raw_datasets/**/
!13_base_method/grip-exp/data/raw_datasets/__init__.py
!13_base_method/grip-exp/data/raw_datasets/**/*.py

# Temporary files
*.log
*.tmp
*.temp
*.bak

# Local benchmark export and LaTeX build caches
/04_benchmark.zip
/11_paper/**/build/
