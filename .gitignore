# macOS / editors
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python environments and caches
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Model and training artifacts
model_cache/
**/model_cache/
wandb/
**/wandb/
*.safetensors
*.ckpt
*.pth
*.pt

# Generated outputs and immutable run data
outputs/
**/outputs/
**/results/*
!**/results/.gitkeep
# Lightweight experiment snapshots (summaries only; never overwrite)
!**/results/archive/
!**/results/archive/**
**/results/archive/**/*.safetensors
**/results/archive/**/*.bin
**/results/archive/**/*.pt
**/results/archive/**/*.pth
**/results/archive/**/*.ckpt
**/results/archive/**/*.npz
**/logs/*.log
**/logs/*.txt

# Temporary files
*.log
!**/results/archive/**/*.log
*.tmp
*.temp
*.bak

# Local HF cache and archived experiment artifacts (too large / regenerable)
.cache/
**/.cache/
*.tar.gz
*.sha256
